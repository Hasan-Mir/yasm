        "@types/node": "^26.1.2",
        "@types/react": "^18.2.43",
        "@types/react-dom": "^18.2.43",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "eslint": "^8.55.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "tsx": "^4.23.1",
        "typescript": "^5.9.3",
        "vite": "^5.0.8",
        "vite-plugin-dts": "^5.0.3",
        "vitest": "^4.1.11"
    }
